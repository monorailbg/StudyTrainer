# Your Gemini API key for AI generation (required)
VITE_GEMINI_API_KEY=your_key_here

# Firebase config — stores notes, flashcards and quizzes in Firestore (all six must be set)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase config — stores uploaded PDF/image file bytes in Supabase Storage (both must be set)
# Create a project at https://supabase.com, then find these under Project Settings > API
# Also create a public storage bucket named "studytrainer" in the Storage section
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
