rules_version = '2';

// Public study library — anyone can read and write.
// No authentication is used; the app is intentionally a shared, open
// workspace. If you later want to lock writes down, add Firebase Auth
// and gate `write` on `request.auth != null`.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
